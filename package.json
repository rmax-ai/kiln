{
  "name": "kiln",
  "version": "0.1.0",
  "private": true,
  "description": "Filesystem-first, evidence-backed knowledge compiler and curator",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome check . && node scripts/check-boundaries.mjs",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "kb": "tsx apps/cli/src/cli.ts",
    "build": "pnpm --filter @kiln/cli build"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@kiln/catalog": "workspace:*",
    "@kiln/config": "workspace:*",
    "@kiln/curation": "workspace:*",
    "@kiln/domain": "workspace:*",
    "@kiln/enrichment": "workspace:*",
    "@kiln/evals": "workspace:*",
    "@kiln/graph": "workspace:*",
    "@kiln/knowledge": "workspace:*",
    "@kiln/models": "workspace:*",
    "@kiln/ontology": "workspace:*",
    "@kiln/source": "workspace:*",
    "@kiln/telemetry": "workspace:*",
    "@kiln/workflows": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "^4.23.12",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
